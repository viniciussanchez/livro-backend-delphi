# Copie para .env (na pasta do executável ou na pasta de onde ele é iniciado)
# e ajuste. O arquivo .env NÃO vai para o Git: ele guarda segredos.
APP_ENV=development
PORT=9003
DB_HOST=localhost
DB_PORT=5432
DB_USER=eventos
DB_PASSWORD=eventos
DB_POOL_SIZE=50
# Em produção: obrigatória, com pelo menos 32 caracteres, igual em todos os serviços.
JWT_SECRET=
EVENT_API_URL=http://127.0.0.1:9001
CUSTOMER_API_URL=http://127.0.0.1:9002
# Tempo limite das chamadas aos outros serviços, em milissegundos.
SERVICE_TIMEOUT_MS=2000
