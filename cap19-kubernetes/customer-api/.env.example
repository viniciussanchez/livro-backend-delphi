# Copie para .env (na pasta do executável ou na pasta de onde ele é iniciado)
# e ajuste. O arquivo .env NÃO vai para o Git: ele guarda segredos.
APP_ENV=development
PORT=9002
DB_HOST=localhost
DB_PORT=5432
DB_USER=eventos
DB_PASSWORD=eventos
DB_POOL_SIZE=50
# Em produção: obrigatória, com pelo menos 32 caracteres, igual em todos os serviços.
JWT_SECRET=
# Primeiro administrador, criado se ainda não existir nenhum.
ADMIN_EMAIL=admin@eventos.local
# Em produção: obrigatória, com pelo menos 12 caracteres.
ADMIN_PASSWORD=
